<?xml version="1.0" encoding="utf-8"?>
<!--
  SPEC §8: nothing goes to cloud backup; a phone-to-phone transfer (Smart Switch, Google's
  "copy apps and data") takes the database. Every domain is excluded from the cloud, so a backup
  there holds nothing. The no_backup folder (this install's id) is never backed up or moved.
  DECISIONS 2026-11-14, "Android backup rules".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
