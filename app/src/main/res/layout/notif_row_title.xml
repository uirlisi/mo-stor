<?xml version="1.0" encoding="utf-8"?>
<!-- The status notification's title line: an optional child's dot, then the title, then (collapsed,
     with a timer running) the counter. Each dot sits on its line's baseline, whatever the font. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="6dp"
        android:baselineAlignBottom="true"
        android:importantForAccessibility="no"
        android:src="@drawable/notif_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <!-- The running timer's counter, collapsed only: expanded, Android shows it in the header. -->
    <Chronometer
        android:id="@+id/counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:visibility="gone" />
</LinearLayout>
